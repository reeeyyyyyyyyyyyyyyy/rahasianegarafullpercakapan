# =============================================
# TIFA App .gitignore
# =============================================

# =============================================
# Dependencies
# =============================================
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml
.pnpm-store/

# =============================================
# Build output
# =============================================
dist/
build/
.vite/
.cache/
*.tsbuildinfo

# =============================================
# Environment
# =============================================
.env
.env.local
.env.*.local
.env.development
.env.production

# =============================================
# Logs
# =============================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =============================================
# Editor / IDE
# =============================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================
# Testing
# =============================================
coverage/
.nyc_output/
*.lcov

# =============================================
# Android (Capacitor)
# =============================================
android/app/build/
android/build/
android/capacitor-cordova-android-plugins/build/
android/.gradle/
android/.idea/
android/local.properties
android/*.iml
android/app/*.iml
android/capacitor-cordova-android-plugins/*.iml
android/captures/
android/.externalNativeBuild/
android/.cxx/

# Keep APK for distribution (optional)
# !android/app/build/outputs/apk/debug/*.apk

# =============================================
# iOS (Capacitor - if used)
# =============================================
ios/App/Pods/
ios/App/.symlinks/
ios/App/build/
ios/DerivedData/
ios/*.xcworkspace/xcuserdata/

# =============================================
# Misc
# =============================================
*.backup
*.bak
*.tmp
*.temp
